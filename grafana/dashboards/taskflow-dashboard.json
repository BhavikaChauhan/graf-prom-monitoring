{
  "title": "TaskFlow — App & Infrastructure",
  "uid": "taskflow-main",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1, "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "title": "App Status", "type": "stat",
      "targets": [{ "expr": "up{job=\"nodeapp\"}", "legendFormat": "App" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }], "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": 0 }, { "color": "green", "value": 1 }] } } }
    },
    {
      "id": 2, "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "title": "Request Rate (RPS)", "type": "stat",
      "targets": [{ "expr": "sum(rate(nodeapp_http_requests_total[5m]))", "legendFormat": "RPS" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 50 }, { "color": "red", "value": 100 }] } } }
    },
    {
      "id": 3, "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "title": "Error Rate", "type": "stat",
      "targets": [{ "expr": "sum(rate(nodeapp_http_requests_total{status_code=~\"5..\"}[5m])) / sum(rate(nodeapp_http_requests_total[5m])) * 100", "legendFormat": "Error %" }],
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] } } }
    },
    {
      "id": 4, "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "title": "p95 Latency", "type": "stat",
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(nodeapp_http_request_duration_seconds_bucket[5m])) by (le)) * 1000", "legendFormat": "p95" }],
      "fieldConfig": { "defaults": { "unit": "ms", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 500 }, { "color": "red", "value": 1000 }] } } }
    },
    {
      "id": 5, "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "title": "CPU Usage", "type": "stat",
      "targets": [{ "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)", "legendFormat": "CPU %" }],
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 90 }] } } }
    },
    {
      "id": 6, "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "title": "Memory Usage", "type": "stat",
      "targets": [{ "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100", "legendFormat": "Memory %" }],
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 75 }, { "color": "red", "value": 90 }] } } }
    },
    {
      "id": 7, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "title": "HTTP Request Rate by Route", "type": "timeseries",
      "targets": [{ "expr": "sum by(route) (rate(nodeapp_http_requests_total[5m]))", "legendFormat": "{{ route }}" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } } }
    },
    {
      "id": 8, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "title": "Response Time Percentiles (p50 / p95 / p99)", "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(nodeapp_http_request_duration_seconds_bucket[5m])) by (le)) * 1000", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(nodeapp_http_request_duration_seconds_bucket[5m])) by (le)) * 1000", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(nodeapp_http_request_duration_seconds_bucket[5m])) by (le)) * 1000", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "lineWidth": 2 } } }
    },
    {
      "id": 9, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "title": "Error Rate Over Time", "type": "timeseries",
      "targets": [{ "expr": "sum(rate(nodeapp_http_requests_total{status_code=~\"5..\"}[5m])) / sum(rate(nodeapp_http_requests_total[5m])) * 100", "legendFormat": "Error %" }],
      "fieldConfig": { "defaults": { "unit": "percent", "custom": { "lineWidth": 2, "fillOpacity": 20 }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "red", "value": 5 }] } } }
    },
    {
      "id": 10, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "title": "Orders Processed (Success vs Failed)", "type": "timeseries",
      "targets": [
        { "expr": "rate(nodeapp_orders_processed_total{status=\"success\"}[5m])", "legendFormat": "Success" },
        { "expr": "rate(nodeapp_orders_processed_total{status=\"failed\"}[5m])", "legendFormat": "Failed" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 2 } },
        "overrides": [{ "matcher": { "id": "byName", "options": "Failed" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }]
      }
    },
    {
      "id": 11, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "title": "CPU Usage Over Time", "type": "timeseries",
      "targets": [{ "expr": "100 - (avg by(cpu) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)", "legendFormat": "CPU {{ cpu }}" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "lineWidth": 2, "fillOpacity": 10 } } }
    },
    {
      "id": 12, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "title": "Memory Usage Over Time", "type": "timeseries",
      "targets": [
        { "expr": "node_memory_MemTotal_bytes", "legendFormat": "Total" },
        { "expr": "node_memory_MemAvailable_bytes", "legendFormat": "Available" },
        { "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes", "legendFormat": "Used" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "lineWidth": 2 } } }
    }
  ]
}
